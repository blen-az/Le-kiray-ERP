# Root Production Environment Configuration Template
# Do NOT commit actual secrets or credentials to source control.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_in_production_secure_pass_123!
POSTGRES_DB=lekiray_erp
POSTGRES_PORT=5432

# Backend Port
PORT=4000

# Security Secrets
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-change-me

# Domain & CORS
FRONTEND_URL=https://erp.yourdomain.com
CORS_ORIGINS=https://erp.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# Initial Super Admin (For db:seed:prod)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
INITIAL_ADMIN_NAME=System Admin
INITIAL_COMPANY_NAME=Contractor PLC
