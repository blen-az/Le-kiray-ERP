datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String    @id @default(uuid())
  name      String
  country   String    @default("Ethiopia")
  currency  String    @default("ETB")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users             User[]
  roles             Role[]
  permissions       Permission[]
  projects          Project[]
  machines          Machine[]
  warehouses        Warehouse[]
  inventoryItems    InventoryItem[]
  inventoryRequests InventoryRequest[]
  employees         Employee[]
  employeeAssignments EmployeeAssignment[]
  leaveRequests     LeaveRequest[]
  dailyReports       DailyReport[]
  dailyReportMachinery DailyReportMachinery[]
  dailyReportMaterials DailyReportMaterial[]
  dailyReportWorkers   DailyReportWorker[]
  dailyReportPhotos    DailyReportPhoto[]
  maintenanceRecords   MaintenanceRecord[]
  maintenanceParts     MaintenancePart[]
  auditLogs            AuditLog[]
  expenses             Expense[]
  projectRevenues      ProjectRevenue[]
  tenders              Tender[]
  tenderChecklistItems TenderChecklistItem[]

  @@map("companies")
}

model User {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  refreshToken String?
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  refreshTokenVersion Int      @default(1)

  // Relations
  roles                      UserRole[]
  managedProjects            Project[]            @relation("ProjectManager")
  managedSites               Site[]               @relation("SiteManager")
  managedWarehouses          Warehouse[]          @relation("WarehouseManager")
  fuelRequestsRequested      FuelRequest[]        @relation("FuelRequestedBy")
  fuelRequestsApproved       FuelRequest[]        @relation("FuelApprovedBy")
  fuelRequestsIssued         FuelRequest[]        @relation("FuelIssuedBy")
  fuelLogsIssued             FuelLog[]            @relation("FuelLogIssuedBy")
  stockMovementsRequested    StockMovement[]      @relation("StockMovementRequestedBy")
  approvedStockMovements     StockMovement[]      @relation("StockMovementApprovedBy")
  stockMovementsIssued       StockMovement[]      @relation("StockMovementIssuedBy")
  inventoryRequestsRequested InventoryRequest[]   @relation("InventoryRequestedBy")
  inventoryRequestsApproved  InventoryRequest[]   @relation("InventoryApprovedBy")
  inventoryRequestsIssued    InventoryRequest[]   @relation("InventoryIssuedBy")
  recordedAttendances        Attendance[]         @relation("AttendanceRecordedBy")
  approvedAttendances        Attendance[]         @relation("AttendanceApprovedBy")
  assignedEmployees          EmployeeAssignment[] @relation("AssignedByEmployee")
  requestedLeaves            LeaveRequest[]       @relation("LeaveRequestedBy")
  approvedLeaves             LeaveRequest[]       @relation("LeaveApprovedBy")
  submittedReports           DailyReport[]        @relation("DailyReportSubmittedBy")
  approvedReports            DailyReport[]        @relation("DailyReportApprovedBy")
  uploadedReportPhotos       DailyReportPhoto[]   @relation("DailyReportPhotoUploadedBy")
  reportedMaintenance        MaintenanceRecord[]  @relation("MaintenanceReportedBy")
  recordedExpenses           Expense[]            @relation("ExpenseRecordedBy")
  approvedExpenses           Expense[]            @relation("ExpenseApprovedBy")
  recordedRevenues           ProjectRevenue[]     @relation("RevenueRecordedBy")
  auditLogs                  AuditLog[]
  ownedTenders               Tender[]             @relation("TenderBidManager")

  @@index([companyId, deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action      String           // e.g. "projects:create"
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  roles RolePermission[]

  @@unique([companyId, action])
  @@map("permissions")
}

model UserRole {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectName        String
  projectCode        String?
  clientName         String?
  location           String
  regionOrCity       String?
  status             String    // "Planning", "Active", "On Track", "At Risk", "Delayed", "Completed", "Suspended", "Cancelled"
  progressPercentage Float     @default(0)
  budget             Float     @default(0)
  startDate          DateTime?
  endDate            DateTime?
  projectManagerId   String?
  projectManager     User?     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  description        String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  sites              Site[]
  warehouses         Warehouse[]
  machineAssignments MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  stockMovements     StockMovement[]
  inventoryRequests  InventoryRequest[]
  dailyReports       DailyReport[]
  currentMachines    Machine[]           @relation("CurrentProjectMachines")
  employeeAssignments EmployeeAssignment[]
  attendance         Attendance[]
  maintenanceRecords MaintenanceRecord[]
  expenses           Expense[]
  projectRevenues    ProjectRevenue[]
  sourceTender       Tender?             @relation("TenderConvertedProject")

  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("projects")
}

model Site {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteName      String
  location      String
  gpsLatitude   Float?
  gpsLongitude  Float?
  siteManagerId String?
  siteManager   User?     @relation("SiteManager", fields: [siteManagerId], references: [id])
  status        String    // "Active", "Inactive", "Delayed", "Completed", "Suspended"
  startDate     DateTime?
  notes         String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  warehouses         Warehouse[]
  machineAssignments MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  employees          Employee[]
  dailyReports       DailyReport[]
  stockMovements     StockMovement[]
  inventoryRequests  InventoryRequest[]
  currentMachines    Machine[]           @relation("CurrentSiteMachines")
  employeeAssignments EmployeeAssignment[]
  attendance         Attendance[]
  maintenanceRecords MaintenanceRecord[]
  expenses           Expense[]

  @@index([companyId, deletedAt])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@map("sites")
}

model Machine {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  machineType        String    // e.g. "Excavator", "Loader", etc.
  brand              String
  model              String
  plateNumber        String?
  serialNumber       String?
  capacity           String?
  ownershipType      String    // "Owned", "Rented from Le’Kiray Marketplace", "Rented Externally"
  source             String    // "Internal Fleet", "Le’Kiray Marketplace", "External Rental Provider"
  currentStatus      String    // "Available", "Assigned", "Active", "Idle", "Under Maintenance", "Returned", "Out of Service"
  currentProjectId   String?
  currentProject     Project?  @relation("CurrentProjectMachines", fields: [currentProjectId], references: [id])
  currentSiteId      String?
  currentSite        Site?     @relation("CurrentSiteMachines", fields: [currentSiteId], references: [id])
  currentOperatorId  String?
  currentOperator    Employee? @relation("MachineCurrentOperator", fields: [currentOperatorId], references: [id])
  rentalStartDate    DateTime?
  rentalEndDate      DateTime?
  dailyRentalCost    Float     @default(0)
  hourlyRentalCost   Float     @default(0)
  notes              String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  assignments        MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  stockMovements     StockMovement[]
  dailyReportMachinery DailyReportMachinery[]
  expenses           Expense[]

  @@map("machines")
}

model MachineAssignment {
  id                 String    @id @default(uuid())
  companyId          String
  machineId          String
  machine            Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId             String
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId         String?
  operator           Employee? @relation("MachineAssignmentOperator", fields: [operatorId], references: [id])
  assignedById       String?
  startDate          DateTime
  endDate            DateTime?
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  status             String    // "Assigned", "Active", "Completed", "Returned", "Cancelled"
  workingHours       Float     @default(0.0)
  idleHours          Float     @default(0.0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?

  @@map("machine_assignments")
}

model FuelRequest {
  id              String    @id @default(uuid())
  companyId       String
  machineId       String
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId      String?
  operator        Employee? @relation("FuelRequestOperator", fields: [operatorId], references: [id])
  requestedById   String
  requestedBy     User      @relation("FuelRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("FuelApprovedBy", fields: [approvedById], references: [id])
  issuedById      String?
  issuedBy        User?     @relation("FuelIssuedBy", fields: [issuedById], references: [id])
  litersRequested Float
  litersApproved  Float     @default(0)
  litersIssued    Float     @default(0)
  costPerLiter    Float?
  totalCost       Float?
  requestDate     DateTime  @default(now())
  approvedAt      DateTime?
  issuedAt        DateTime?
  status          String    // "Pending", "Approved", "Rejected", "Issued", "Partially Issued", "Cancelled"
  priority        String    // "Low", "Normal", "High", "Urgent"
  purpose         String?
  notes           String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  // Relations
  fuelLogs       FuelLog[]
  stockMovements StockMovement[]

  @@map("fuel_requests")
}

model FuelLog {
  id                         String       @id @default(uuid())
  companyId                  String
  fuelRequestId              String?
  fuelRequest                FuelRequest? @relation(fields: [fuelRequestId], references: [id], onDelete: SetNull)
  machineId                  String
  machine                    Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId                  String
  project                    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId                     String
  site                       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId                 String?
  operator                   Employee?    @relation("FuelLogOperator", fields: [operatorId], references: [id])
  issuedById                 String?
  issuedBy                   User?        @relation("FuelLogIssuedBy", fields: [issuedById], references: [id])
  litersUsed                 Float
  costPerLiter               Float
  totalCost                  Float
  usageDate                  DateTime     @default(now())
  workingHours               Float        @default(0.0)
  odometerOrHourMeterReading Float?
  receiptUrl                 String?
  notes                      String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  deletedAt                  DateTime?
  createdById                String?
  updatedById                String?

  @@map("fuel_logs")
}

model Warehouse {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseName String
  warehouseCode String?
  type          String    @default("Main Warehouse") // "Main Warehouse", "Site Store", "Fuel Store", "Tool Store", "Spare Parts Store", "Temporary Store"
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId        String?
  site          Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location      String?
  managerId     String?
  manager       User?     @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  status        String    @default("Active") // "Active", "Inactive"
  notes         String?   @db.Text
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  inventoryItems InventoryItem[]
  defaultItems   InventoryItem[] @relation("DefaultWarehouse")
  fromMovements  StockMovement[] @relation("FromWarehouse")
  toMovements    StockMovement[] @relation("ToWarehouse")
  stockMovements StockMovement[] @relation("LegacyWarehouse")

  @@map("warehouses")
}

model InventoryItem {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemName           String
  itemCode           String?
  category           String    // e.g. "Cement", "Rebar", "Diesel", "Spare Parts", etc.
  unit               String    // e.g. "Bag", "Kg", "Ton", "Liter", "Piece", etc.
  description        String?   @db.Text
  currentQuantity    Float     @default(0.0)
  minimumStockLevel  Float     @default(0.0)
  maximumStockLevel  Float?
  averageUnitCost    Float     @default(0.0)
  totalValue         Float     @default(0.0)
  defaultWarehouseId String?
  defaultWarehouse   Warehouse? @relation("DefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  isFuelItem         Boolean   @default(false)
  isConsumable       Boolean   @default(false)
  isTool             Boolean   @default(false)
  isSparePart        Boolean   @default(false)
  status             String    @default("Active") // "Active", "Inactive", "Low Stock", "Out of Stock"
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  stockMovements    StockMovement[]
  inventoryRequests InventoryRequest[]
  dailyReportMaterials DailyReportMaterial[]
  maintenanceParts  MaintenancePart[]
  legacyWarehouse   Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId       String?

  @@map("inventory_items")
}

model StockMovement {
  id              String         @id @default(uuid())
  companyId       String
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromWarehouseId String?
  fromWarehouse   Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId   String?
  toWarehouse     Warehouse?     @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  warehouseId     String?
  warehouse       Warehouse?     @relation("LegacyWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId          String?
  site            Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  requestedById   String?
  requestedBy     User?          @relation("StockMovementRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("StockMovementApprovedBy", fields: [approvedById], references: [id])
  issuedById      String?
  issuedBy        User?          @relation("StockMovementIssuedBy", fields: [issuedById], references: [id])
  movementType    String         // "STOCK_IN", "STOCK_OUT", "TRANSFER", "ADJUSTMENT_IN", "ADJUSTMENT_OUT", "RETURN", "DAMAGED", "LOST", "FUEL_ISSUE"
  quantity        Float
  unitCost        Float          @default(0.0)
  totalCost       Float          @default(0.0)
  movementDate    DateTime       @default(now())
  referenceNumber String?
  reason          String?
  notes           String?        @db.Text
  fuelRequestId   String?
  fuelRequest     FuelRequest?   @relation(fields: [fuelRequestId], references: [id], onDelete: SetNull)
  machineId       String?
  machine         Machine?       @relation(fields: [machineId], references: [id], onDelete: SetNull)
  createdById     String?
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@map("stock_movements")
}

model InventoryRequest {
  id                String        @id @default(uuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User          @relation("InventoryRequestedBy", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?         @relation("InventoryApprovedBy", fields: [approvedById], references: [id])
  issuedById        String?
  issuedBy          User?         @relation("InventoryIssuedBy", fields: [issuedById], references: [id])
  quantityRequested Float
  quantityApproved  Float         @default(0.0)
  quantityIssued    Float         @default(0.0)
  status            String        @default("Pending") // "Pending", "Approved", "Rejected", "Issued", "Partially Issued", "Cancelled"
  priority          String        @default("Normal")  // "Low", "Normal", "High", "Urgent"
  requestDate       DateTime      @default(now())
  approvedAt        DateTime?
  issuedAt          DateTime?
  purpose           String?
  notes             String?       @db.Text
  rejectionReason   String?       @db.Text
  createdById       String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@map("inventory_requests")
}

model Employee {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeCode          String?
  firstName             String
  middleName            String?
  lastName              String
  phone                 String?
  email                 String?
  gender                String?   // "Male", "Female"
  dateOfBirth           DateTime?
  nationalIdNumber      String?
  position              String    @default("Daily Laborer") // Job Title e.g. "Machine Operator", "Site Manager", "Daily Laborer"
  department            String?
  employmentType        String    @default("Permanent")     // "Permanent", "Contract", "Temporary", "Daily Laborer", "Part Time", "Intern", "Consultant"
  employmentStatus      String    @default("Active")        // "Active", "Inactive", "On Leave", "Suspended", "Terminated", "Resigned"
  hireDate              DateTime?
  terminationDate       DateTime?
  dailyRate             Float     @default(0.0)
  monthlySalary         Float     @default(0.0)
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  documentUrl           String?
  notes                 String?   @db.Text
  role                  String?   // Legacy job title fallback
  siteId                String?
  site                  Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?

  // Relations
  attendance         Attendance[]
  assignments        EmployeeAssignment[]
  leaveRequests      LeaveRequest[]
  currentMachines    Machine[]           @relation("MachineCurrentOperator")
  machineAssignments MachineAssignment[] @relation("MachineAssignmentOperator")
  fuelRequests       FuelRequest[]       @relation("FuelRequestOperator")
  fuelLogs           FuelLog[]           @relation("FuelLogOperator")
  dailyReportMachinery DailyReportMachinery[]
  dailyReportWorkers DailyReportWorker[]
  mechanicMaintenanceRecords MaintenanceRecord[] @relation("MaintenanceMechanic")

  @@map("employees")
}

model EmployeeAssignment {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?     @relation("AssignedByEmployee", fields: [assignedById], references: [id], onDelete: SetNull)
  positionOnSite String?
  startDate      DateTime
  endDate        DateTime?
  status         String    @default("Active") // "Active", "Completed", "Transferred", "Cancelled"
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("employee_assignments")
}

model Attendance {
  id             String    @id @default(uuid())
  companyId      String
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  date           DateTime  @default(now()) // Legacy date field
  attendanceDate DateTime  @default(now())
  status         String    // "Present", "Absent", "Late", "On Leave", "Half Day", "Sick", "Permission", "Holiday"
  checkInTime    DateTime?
  checkOutTime   DateTime?
  regularHours   Float     @default(8.0)
  overtimeHours  Float     @default(0.0)
  remarks        String?   @db.Text
  notes          String?   @db.Text
  recordedById   String?
  recordedBy     User?     @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  approvedById   String?
  approvedBy     User?     @relation("AttendanceApprovedBy", fields: [approvedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  @@map("attendance")
}

model LeaveRequest {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById   String?
  requestedBy     User?     @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("LeaveApprovedBy", fields: [approvedById], references: [id])
  leaveType       String    // "Annual Leave", "Sick Leave", "Emergency Leave", "Maternity Leave", "Paternity Leave", "Unpaid Leave", "Permission", "Other"
  startDate       DateTime
  endDate         DateTime
  totalDays       Float     @default(1.0)
  status          String    @default("Pending") // "Pending", "Approved", "Rejected", "Cancelled"
  reason          String?   @db.Text
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("leave_requests")
}

model DailyReport {
  id                  String    @id @default(uuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date                DateTime  @default(now()) // Legacy date field
  reportDate          DateTime  @default(now())
  submittedById       String
  submittedBy         User      @relation("DailyReportSubmittedBy", fields: [submittedById], references: [id])
  approvedById        String?
  approvedBy          User?     @relation("DailyReportApprovedBy", fields: [approvedById], references: [id])
  status              String    @default("Draft") // "Draft", "Submitted", "Approved", "Rejected", "Cancelled"
  weatherCondition    String    @default("Sunny") // "Sunny", "Cloudy", "Rainy", "Windy", "Dusty", "Partly Cloudy", "Other"
  workCompleted       String    @db.Text
  workPlannedTomorrow String?   @db.Text
  issuesOrBlockers    String?   @db.Text
  safetyIncidents     String?   @db.Text
  qualityIssues       String?   @db.Text
  generalNotes        String?   @db.Text
  workersPresent      Int       @default(0)
  workersAbsent       Int       @default(0)
  totalRegularHours   Float     @default(0.0)
  totalOvertimeHours  Float     @default(0.0)
  machineryUsedCount  Int       @default(0)
  machineryUsed       String?   @db.Text // Legacy summary text
  materialsUsed       String?   @db.Text // Legacy summary text
  fuelUsed            Float?    @default(0.0) // Legacy fuel summary
  fuelUsedLiters      Float     @default(0.0)
  materialsUsedValue  Float     @default(0.0)
  photos              String?   @db.Text // JSON string array of photo URLs
  documents           String?   @db.Text // JSON string array of doc URLs
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?   @db.Text
  createdById         String?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Detail relations
  machineryRecords    DailyReportMachinery[]
  materialRecords     DailyReportMaterial[]
  workerRecords       DailyReportWorker[]
  photoRecords        DailyReportPhoto[]

  @@map("daily_reports")
}

model DailyReportMachinery {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dailyReportId  String
  dailyReport    DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  machineId      String
  machine        Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operatorId     String?
  operator       Employee?   @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  workingHours   Float       @default(0.0)
  idleHours      Float       @default(0.0)
  fuelUsedLiters Float       @default(0.0)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@map("daily_report_machinery")
}

model DailyReportMaterial {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dailyReportId   String
  dailyReport     DailyReport   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityUsed    Float         @default(0.0)
  unit            String?
  estimatedCost   Float         @default(0.0)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@map("daily_report_materials")
}

model DailyReportWorker {
  id               String      @id @default(uuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dailyReportId    String
  dailyReport      DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceStatus String      @default("Present")
  regularHours     Float       @default(8.0)
  overtimeHours    Float       @default(0.0)
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  @@map("daily_report_workers")
}

model DailyReportPhoto {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  fileUrl       String
  caption       String?
  uploadedById  String?
  uploadedBy    User?       @relation("DailyReportPhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@map("daily_report_photos")
}

model MaintenanceRecord {
  id                         String            @id @default(uuid())
  companyId                  String
  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  machineId                  String
  machine                    Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId                  String?
  project                    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId                     String?
  site                       Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reportedById               String?
  reportedBy                 User?             @relation("MaintenanceReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedMechanicId         String?
  assignedMechanic           Employee?         @relation("MaintenanceMechanic", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  maintenanceType            String            // "Preventive Maintenance", "Corrective Maintenance", "Breakdown Repair", "Inspection", "Oil Change", "Tire Service", "Hydraulic Service", "Electrical Repair", "Engine Repair", "General Service", "Other"
  status                     String            @default("Reported") // "Reported", "Scheduled", "In Progress", "Completed", "Cancelled", "Deferred"
  priority                   String            @default("Normal") // "Low", "Normal", "High", "Urgent", "Critical"
  issueTitle                 String
  issueDescription           String?           @db.Text
  diagnosis                  String?           @db.Text
  workPerformed              String?           @db.Text
  partsUsedValue             Float             @default(0.0)
  laborCost                  Float             @default(0.0)
  externalServiceCost        Float             @default(0.0)
  totalCost                  Float             @default(0.0)
  downtimeHours              Float             @default(0.0)
  reportedDate               DateTime          @default(now())
  scheduledDate              DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  nextServiceDate            DateTime?
  odometerOrHourMeterReading Float?
  notes                      String?           @db.Text
  createdById                String?
  updatedById                String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  deletedAt                  DateTime?

  // Relations
  partsUsed                  MaintenancePart[]

  @@map("maintenance_records")
}

model MaintenancePart {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  inventoryItemId     String
  inventoryItem       InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityUsed        Float
  unitCost            Float             @default(0.0)
  totalCost           Float             @default(0.0)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@map("maintenance_parts")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Expense {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId           String?
  site             Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  machineId        String?
  machine          Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  expenseCategory  String    // Fuel, Inventory / Materials, Machinery Rental, Maintenance, Labor, Transport, Subcontractor, Tools and Equipment, Site Office, Utilities, Permit / Government Fee, Miscellaneous, Other
  expenseType      String?   // e.g. Operational, Direct, Overhead, Invoice
  amount           Float
  currency         String    @default("ETB")
  expenseDate      DateTime
  description      String?   @db.Text
  vendorName       String?
  receiptUrl       String?
  referenceNumber  String?
  recordedById     String?
  recordedBy       User?     @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  status           String    @default("Recorded") // Draft, Recorded, Approved, Rejected, Cancelled
  notes            String?   @db.Text
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@map("expenses")
}

model ProjectRevenue {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String    @default("ETB")
  revenueDate   DateTime
  description   String?   @db.Text
  clientName    String?
  invoiceNumber String?
  status        String    @default("Recorded") // Draft, Recorded, Invoiced, Received
  recordedById  String?
  recordedBy    User?     @relation("RevenueRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("project_revenues")
}

model Tender {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderNumber          String    // Procuring entity reference, e.g. "ERA/NCB/W-014/2026"
  title                 String
  procuringEntity       String    // Client issuing the tender, e.g. "Ethiopian Roads Administration"
  category              String    // "Road Construction", "Building Construction", "Bridge & Structures", "Water & Irrigation", "Earthworks", "Machinery Rental", "Supply", "Consultancy", "Other"
  procurementMethod     String    @default("Open National Bidding") // "Open National Bidding", "Open International Bidding", "Restricted Bidding", "Request for Quotation", "Direct Procurement"
  source                String?   // "e-GP Portal", "Newspaper", "Direct Invitation", "Le’Kiray Marketplace", "Other"
  requiredGrade         String?   // Contractor licence grade, e.g. "GC-1", "RC-3"
  location              String?
  regionOrCity          String?
  description           String?   @db.Text
  status                String    @default("Identified") // "Identified", "Preparing", "Submitted", "Under Evaluation", "Won", "Lost", "No Bid", "Cancelled"
  winProbability        Int       @default(50) // 0 - 100, bid manager estimate
  estimatedValue        Float     @default(0)  // Engineer estimate / client budget (ETB)
  bidAmount             Float?                 // Our submitted bid price (ETB)
  currency              String    @default("ETB")
  documentFee           Float     @default(0)
  bidSecurityAmount     Float     @default(0)
  bidSecurityType       String?   // "Bank Guarantee", "CPO", "Insurance Bond", "Cash"
  bidSecurityReturned   Boolean   @default(false)
  publishedDate         DateTime?
  siteVisitDate         DateTime?
  clarificationDeadline DateTime?
  submissionDeadline    DateTime
  openingDate           DateTime?
  submittedAt           DateTime?
  decidedAt             DateTime?
  awardedTo             String?   // Winning bidder when lost
  awardedAmount         Float?
  outcomeNotes          String?   @db.Text // Loss reason / no-bid reason / award notes
  bidManagerId          String?
  bidManager            User?     @relation("TenderBidManager", fields: [bidManagerId], references: [id], onDelete: SetNull)
  convertedProjectId    String?   @unique
  convertedProject      Project?  @relation("TenderConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  createdById           String?
  updatedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // Relations
  checklist             TenderChecklistItem[]

  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@index([companyId, submissionDeadline])
  @@map("tenders")
}

model TenderChecklistItem {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId    String
  tender      Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  label       String
  isDone      Boolean   @default(false)
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, tenderId])
  @@map("tender_checklist_items")
}
