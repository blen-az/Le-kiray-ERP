datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String    @id @default(uuid())
  name      String
  country   String    @default("Ethiopia")
  currency  String    @default("ETB")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users             User[]
  roles             Role[]
  permissions       Permission[]
  projects          Project[]
  machines          Machine[]
  warehouses        Warehouse[]
  employees         Employee[]
  auditLogs         AuditLog[]

  @@map("companies")
}

model User {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  refreshToken String?

  // Relations
  roles                  UserRole[]
  managedProjects        Project[]         @relation("ProjectManager")
  managedSites           Site[]            @relation("SiteManager")
  fuelRequestsRequested  FuelRequest[]     @relation("FuelRequestedBy")
  fuelRequestsApproved   FuelRequest[]     @relation("FuelApprovedBy")
  fuelRequestsIssued     FuelRequest[]     @relation("FuelIssuedBy")
  fuelLogsIssued         FuelLog[]         @relation("FuelLogIssuedBy")
  approvedStockMovements StockMovement[]   @relation("StockMovementApprovedBy")
  recordedAttendances    Attendance[]      @relation("AttendanceRecordedBy")
  submittedReports       DailyReport[]     @relation("DailyReportSubmittedBy")
  auditLogs              AuditLog[]

  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action      String           // e.g. "projects:create"
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  roles RolePermission[]

  @@unique([companyId, action])
  @@map("permissions")
}

model UserRole {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectName        String
  projectCode        String?
  clientName         String?
  location           String
  regionOrCity       String?
  status             String    // "Planning", "Active", "On Track", "At Risk", "Delayed", "Completed", "Suspended", "Cancelled"
  progressPercentage Float     @default(0)
  budget             Float     @default(0)
  startDate          DateTime?
  endDate            DateTime?
  projectManagerId   String?
  projectManager     User?     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  description        String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  sites              Site[]
  machineAssignments MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  stockMovements     StockMovement[]
  dailyReports       DailyReport[]
  currentMachines    Machine[]           @relation("CurrentProjectMachines")

  @@map("projects")
}

model Site {
  id            String    @id @default(uuid())
  companyId     String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteName      String
  location      String
  gpsLatitude   Float?
  gpsLongitude  Float?
  siteManagerId String?
  siteManager   User?     @relation("SiteManager", fields: [siteManagerId], references: [id])
  status        String    // "Active", "Inactive", "Delayed", "Completed", "Suspended"
  startDate     DateTime?
  notes         String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  machineAssignments MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  employees          Employee[]
  dailyReports       DailyReport[]
  stockMovements     StockMovement[]
  currentMachines    Machine[]           @relation("CurrentSiteMachines")

  @@map("sites")
}

model Machine {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  machineType        String    // e.g. "Excavator", "Loader", etc.
  brand              String
  model              String
  plateNumber        String?
  serialNumber       String?
  capacity           String?
  ownershipType      String    // "Owned", "Rented from Le’Kiray Marketplace", "Rented Externally"
  source             String    // "Internal Fleet", "Le’Kiray Marketplace", "External Rental Provider"
  currentStatus      String    // "Available", "Assigned", "Active", "Idle", "Under Maintenance", "Returned", "Out of Service"
  currentProjectId   String?
  currentProject     Project?  @relation("CurrentProjectMachines", fields: [currentProjectId], references: [id])
  currentSiteId      String?
  currentSite        Site?     @relation("CurrentSiteMachines", fields: [currentSiteId], references: [id])
  currentOperatorId  String?
  currentOperator    Employee? @relation("MachineCurrentOperator", fields: [currentOperatorId], references: [id])
  rentalStartDate    DateTime?
  rentalEndDate      DateTime?
  dailyRentalCost    Float     @default(0)
  hourlyRentalCost   Float     @default(0)
  notes              String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  assignments        MachineAssignment[]
  fuelRequests       FuelRequest[]
  fuelLogs           FuelLog[]
  maintenanceRecords MaintenanceRecord[]

  @@map("machines")
}

model MachineAssignment {
  id                 String    @id @default(uuid())
  companyId          String
  machineId          String
  machine            Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId             String
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId         String?
  operator           Employee? @relation("MachineAssignmentOperator", fields: [operatorId], references: [id])
  assignedById       String?
  startDate          DateTime
  endDate            DateTime?
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  status             String    // "Assigned", "Active", "Completed", "Returned", "Cancelled"
  workingHours       Float     @default(0.0)
  idleHours          Float     @default(0.0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?

  @@map("machine_assignments")
}

model FuelRequest {
  id              String    @id @default(uuid())
  companyId       String
  machineId       String
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId      String?
  operator        Employee? @relation("FuelRequestOperator", fields: [operatorId], references: [id])
  requestedById   String
  requestedBy     User      @relation("FuelRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("FuelApprovedBy", fields: [approvedById], references: [id])
  issuedById      String?
  issuedBy        User?     @relation("FuelIssuedBy", fields: [issuedById], references: [id])
  litersRequested Float
  litersApproved  Float     @default(0)
  litersIssued    Float     @default(0)
  costPerLiter    Float?
  totalCost       Float?
  requestDate     DateTime  @default(now())
  approvedAt      DateTime?
  issuedAt        DateTime?
  status          String    // "Pending", "Approved", "Rejected", "Issued", "Partially Issued", "Cancelled"
  priority        String    // "Low", "Normal", "High", "Urgent"
  purpose         String?
  notes           String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  // Relations
  fuelLogs FuelLog[]

  @@map("fuel_requests")
}

model FuelLog {
  id                         String       @id @default(uuid())
  companyId                  String
  fuelRequestId              String?
  fuelRequest                FuelRequest? @relation(fields: [fuelRequestId], references: [id], onDelete: SetNull)
  machineId                  String
  machine                    Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  projectId                  String
  project                    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId                     String
  site                       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operatorId                 String?
  operator                   Employee?    @relation("FuelLogOperator", fields: [operatorId], references: [id])
  issuedById                 String?
  issuedBy                   User?        @relation("FuelLogIssuedBy", fields: [issuedById], references: [id])
  litersUsed                 Float
  costPerLiter               Float
  totalCost                  Float
  usageDate                  DateTime     @default(now())
  workingHours               Float        @default(0.0)
  odometerOrHourMeterReading Float?
  receiptUrl                 String?
  notes                      String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  deletedAt                  DateTime?
  createdById                String?
  updatedById                String?

  @@map("fuel_logs")
}

model Warehouse {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model InventoryItem {
  id            String    @id @default(uuid())
  companyId     String
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name          String
  category      String    // e.g. "CEMENT", "REBAR", "DIESEL"
  unit          String    // e.g. "BAGS", "PCS", "LITERS"
  quantity      Float     @default(0.0)
  minStockAlert Float     @default(10.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  // Relations
  stockMovements StockMovement[]

  @@unique([warehouseId, name])
  @@map("inventory_items")
}

model StockMovement {
  id              String    @id @default(uuid())
  companyId       String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId          String?
  site            Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  quantity        Float     // Positive for stock-in, Negative for stock-out
  movementType    String    // "STOCK_IN", "STOCK_OUT", "TRANSFER"
  approvedById    String?
  approvedBy      User?     @relation("StockMovementApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  @@map("stock_movements")
}

model Employee {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  role        String    // Job Title e.g. "OPERATOR", "SITE_MANAGER"
  siteId      String?
  site        Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  attendance         Attendance[]
  currentMachines    Machine[]           @relation("MachineCurrentOperator")
  assignments        MachineAssignment[] @relation("MachineAssignmentOperator")
  fuelRequests       FuelRequest[]       @relation("FuelRequestOperator")
  fuelLogs           FuelLog[]           @relation("FuelLogOperator")

  @@map("employees")
}

model Attendance {
  id           String    @id @default(uuid())
  companyId    String
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime
  status       String    // "PRESENT", "ABSENT", "LATE", "ON_LEAVE"
  remarks      String?
  recordedById String
  recordedBy   User      @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?

  @@unique([employeeId, date])
  @@map("attendance")
}

model DailyReport {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date           DateTime
  workCompleted  String    @db.Text
  machineryUsed  String?   @db.Text
  workersPresent Int       @default(0)
  materialsUsed  String?   @db.Text
  fuelUsed       Float?    @default(0.0)
  issuesBlockers String?   @db.Text
  photos         String?   @db.Text
  submittedById  String
  submittedBy    User      @relation("DailyReportSubmittedBy", fields: [submittedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  @@unique([siteId, date])
  @@map("daily_reports")
}

model MaintenanceRecord {
  id              String    @id @default(uuid())
  companyId       String
  machineId       String
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  description     String    @db.Text
  maintenanceType String    // "PREVENTIVE", "BREAKDOWN", "INSPECTION"
  cost            Float
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  @@map("maintenance_records")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
