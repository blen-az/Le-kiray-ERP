# NestJS Backend Environment Template

# Environment Mode
NODE_ENV=production
PORT=4000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:change_this_pass@localhost:5432/lekiray_erp?schema=public

# Authentication & Security
JWT_SECRET=change-this-jwt-secret-minimum-32-chars-long-string
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-chars-long-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Domain & CORS
FRONTEND_URL=https://erp.yourdomain.com
CORS_ORIGINS=https://erp.yourdomain.com,https://app.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# Throttling & Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Observability & Logging
SENTRY_DSN=

# File Storage (S3-Compatible Storage Configuration)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=lekiray-uploads-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Initial Super Admin (Used only during initial db:seed:prod)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
INITIAL_ADMIN_NAME=System Admin
INITIAL_COMPANY_NAME=Contractor PLC
